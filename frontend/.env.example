# Copy to frontend/.env.local to override the defaults for your own setup.

# Where the backend API runs
VITE_LOCAL_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Branding (see src/config/branding.js)
VITE_APP_NAME=Lab Attendance
VITE_INSTITUTE_NAME=Your Institute
VITE_INSTITUTE_SHORT_NAME=LAB
# A path under frontend/public or a full URL
VITE_LOGO_URL=/logos/logo.svg
